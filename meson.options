option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How libpkgcatalog-acquire links against dependencies',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the acquisition test suite',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Install generated manual pages',
)
option(
  'scan_tool',
  type: 'feature',
  value: 'enabled',
  description: 'Build the pkgcatalog-scan reference frontend',
)
option(
  'html_docs',
  type: 'feature',
  value: 'disabled',
  description: 'Generate and install versioned static HTML documentation',
)
